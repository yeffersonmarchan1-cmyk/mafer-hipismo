{
  "name": "mafer-hipismo",
  "version": "0.1.0",
  "private": true,
  "description": "Administración de jornadas hípicas de La Rinconada",
  "author": "MAFER Hipismo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:desktop": "npm run build && node scripts/prepare-desktop.cjs && electron-builder --win nsis",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap-admin": "node --env-file=.env scripts/bootstrap-admin.cjs"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.maferhipismo.desktop",
    "productName": "MAFER Hipismo",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*",
          "**/node_modules/**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "pdfjs-dist": "^5.7.284",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
